    "hosted-compute-*.githubapp.com"
  ],
  "deny": [
    "gist.github.com",
    "gist.githubusercontent.com",
    "raw.githubusercontent.com"
  ],
  "flow_log": "/var/log/safer-runner/proxy-flows.jsonl",
  "container_tls": "sni-only",
