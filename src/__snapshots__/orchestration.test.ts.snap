exports[`setup transcript (runSetup on a recording fake runner) enforce, docker: keep with running service containers: transcript 1`] = `
"$ sudo --version [ignore-rc] [silent]
$ <net.listen> 26383
$ <net.listen> 26384
$ <fetch> https://api.github.com/meta
$ sudo -E apt-get install -y -qq --no-install-recommends conntrack [ignore-rc]
$ sudo mkdir -p /var/log/safer-runner
$ sudo chown syslog:adm /var/log/safer-runner
$ sudo chmod 755 /var/log/safer-runner
$ sudo useradd --system --no-create-home --shell /usr/sbin/nologin --uid 62500 dns-abababababababab
$ id -u safer-runner-proxy [ignore-rc] [silent]
$ sudo useradd --system --no-create-home --shell /usr/sbin/nologin safer-runner-proxy
$ id -u safer-runner-proxy [silent]
$ sudo install -d -m 0755 -o root -g root /opt/safer-runner/proxy
$ sudo install -m 0644 -o root -g root /home/runner/work/_actions/portswigger-tim/safer-runner-action/v2.3.0/proxy/policy.py /opt/safer-runner/proxy/policy.py
$ sudo install -m 0644 -o root -g root /home/runner/work/_actions/portswigger-tim/safer-runner-action/v2.3.0/proxy/policy_core.py /opt/safer-runner/proxy/policy_core.py
$ sudo install -d -m 0755 -o root -g root /etc/safer-runner
$ sudo tee /etc/safer-runner/policy.json [silent]  <<< 1010 bytes, sha256:093ac77c142e
$ sudo chown root:root /etc/safer-runner/policy.json
$ sudo chmod 0644 /etc/safer-runner/policy.json
$ sudo touch /var/log/safer-runner/proxy-flows.jsonl
$ sudo chown safer-runner-proxy:safer-runner-proxy /var/log/safer-runner/proxy-flows.jsonl
$ sudo chmod 0644 /var/log/safer-runner/proxy-flows.jsonl
$ sudo install -d -m 0755 -o root -g root /run/safer-runner
$ sudo install -d -m 0700 -o safer-runner-proxy -g safer-runner-proxy /run/safer-runner/proxy
$ sudo -u safer-runner-proxy sh -c umask 077 && openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3 -keyout "$1" -out "$2" -subj "$3" -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign && cat "$1" "$2" > "$4" && rm -f "$1" sh /run/safer-runner/proxy/ca-key.pem /run/safer-runner/proxy/ca-cert.pem /O=safer-runner/CN=safer-runner ephemeral CA 1234567890 /run/safer-runner/proxy/mitmproxy-ca.pem
$ sudo install -m 0644 -o root -g root /run/safer-runner/proxy/ca-cert.pem /etc/safer-runner/ca.pem
$ sudo systemctl stop safer-runner-proxy [ignore-rc] [silent]
$ sudo systemctl reset-failed safer-runner-proxy [ignore-rc] [silent]
$ sudo systemd-run --unit=safer-runner-proxy --description=safer-runner egress proxy --uid=safer-runner-proxy --gid=safer-runner-proxy -p Restart=always -p RestartSec=1 -p UMask=0077 -p NoNewPrivileges=yes -p PrivateTmp=yes -p ProtectHome=yes -p ProtectSystem=strict -p ReadWritePaths=/run/safer-runner/proxy /var/log/safer-runner/proxy-flows.jsonl -p LimitNOFILE=65536 --setenv=HOME=/run/safer-runner/proxy --setenv=SAFER_RUNNER_POLICY=/etc/safer-runner/policy.json /opt/safer-runner/bin/mitmdump --mode transparent@127.0.0.1:26383 --mode transparent@127.0.0.1:26384 --set confdir=/run/safer-runner/proxy --set connection_strategy=lazy --set stream_large_bodies=1m --set block_global=false --set flow_detail=0 --set termlog_verbosity=warn -s /opt/safer-runner/proxy/policy.py
$ ss -Hltn sport = :26383 [ignore-rc] [silent]
$ ss -Hltn sport = :26384 [ignore-rc] [silent]
$ sudo install -m 0644 -o root -g root /etc/safer-runner/ca.pem /usr/local/share/ca-certificates/safer-runner-ca.crt
$ sudo update-ca-certificates [silent]
$ <export> NODE_EXTRA_CA_CERTS=/etc/safer-runner/ca.pem
$ <export> NODE_USE_SYSTEM_CA=1
$ <export> REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
$ <export> PIP_CERT=/etc/ssl/certs/ca-certificates.crt
$ <export> SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
$ <export> GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt
$ <export> AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
$ <export> CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
$ sudo /usr/lib/jvm/temurin-17-jdk-amd64/bin/keytool -delete -noprompt -keystore /usr/lib/jvm/temurin-17-jdk-amd64/lib/security/cacerts -storepass changeit -alias safer-runner-ca [ignore-rc] [silent]
