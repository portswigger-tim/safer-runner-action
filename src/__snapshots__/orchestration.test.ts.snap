$ sudo iptables -L SAFER_RUNNER_OUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L OUTPUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L SAFER_RUNNER_NAT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L DOCKER-USER -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L SAFER_RUNNER_CFWD -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L SAFER_RUNNER_CNAT -n --line-numbers [ignore-rc] [silent]
$ sudo touch /etc/safer-runner/validation-state.json
$ sudo chown root:root /etc/safer-runner/validation-state.json
$ sudo chmod 0600 /etc/safer-runner/validation-state.json
$ sudo tee /etc/safer-runner/validation-state.json [silent]  <<< 3687 bytes, sha256:4330be89fb8c
$ sudo tee /tmp/runner-sudoers.tmp  <<< 1668 bytes, sha256:a39bdd4294b3
$ sudo visudo -c -f /tmp/runner-sudoers.tmp [ignore-rc]
$ sudo chmod 0440 /tmp/runner-sudoers.tmp
$ sudo chown root:root /tmp/runner-sudoers.tmp
$ sudo mv /tmp/runner-sudoers.tmp /etc/sudoers.d/runner"
`;

exports[`setup transcript (runSetup on a recording fake runner) enforce on sudo-rs, sudo-config: warnings 1`] = `
[
  "warning: sudo-config: '/usr/bin/apt-get update' gives the job root (apt-get can run or write anything), so sudo can remove the egress controls",
  "warning: sudo-config: '/usr/bin/apt-get install *' gives the job root (apt-get can run or write anything), so sudo can remove the egress controls",
  "warning: enforce is ADVISORY in this job: sudo-config keeps 3 sudo command line(s), and a command that can run code or write files gives the job root, which can remove the egress controls. Remove sudo-config to make enforce a boundary.",
]
`;

