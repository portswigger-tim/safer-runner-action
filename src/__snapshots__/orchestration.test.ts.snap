    fallthrough
  }
  cache 3600 {
    serve_stale 1h
  }
  forward . 9.9.9.9 149.112.112.112 {
    policy sequential
  }
}
.:53 {
  bind 127.0.0.1
  log . "{remote} BLOCK {type} {name} {rcode}"
  errors
  template ANY ANY {
    rcode NXDOMAIN
  }
}
