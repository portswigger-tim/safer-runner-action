exports[`setup transcript (runSetup on a recording fake runner) enforce, docker: stop, disable-sudo: false: warnings 1`] = `
[
  "warning: enforce is ADVISORY in this job: sudo is retained (disable-sudo: false), so any step can use it to remove the egress controls. This is not an enforced boundary. Remove disable-sudo: false to make enforce a boundary.",
]
`;

exports[`setup transcript (runSetup on a recording fake runner) enforce, sudo-config: files 1`] = `
{
  "/etc/resolv.conf": "nameserver 127.0.0.1
",
  "/etc/rsyslog.d/10-iptables-safer-runner-v2.conf": "if $programname == 'kernel' and $msg contains ['SaferRunner-Drop:', 'SaferRunner-Egress:', 'SaferRunner-CDrop:', 'SaferRunner-CEgress:'] then /var/log/safer-runner/firewall.log
",
  "/etc/safer-runner/Corefile": "# safer-runner CoreDNS resolver (enforce). Generated - do not edit.
# Blocks are tried in order: the first whose view matches answers the query.
.:53 {
  bind 127.0.0.1
  view allow {
    expr ((name() in ['github.com.', 'objects.githubusercontent.com.', 'productionresultssa1.blob.core.windows.net.', 'fulcio.githubapp.com.', 'pkg-containers.githubusercontent.com.', 'registry.npmjs.org.', 'example.org.'] || name() endsWith '.github.com.' || name() endsWith '.actions.githubusercontent.com.' || name() endsWith '.example.org.' || name() matches '^hosted-compute-[a-z0-9_-]*[.]githubapp[.]com[.]$') && !(name() in ['gist.github.com.', 'gist.githubusercontent.com.', 'raw.githubusercontent.com.'])) || name() in ['localhost.', 'ip6-localhost.', 'ip6-loopback.', 'fv-az123-456.']
  }
  metadata
  log . "{remote} ALLOW {type} {name} {rcode} upstream={/forward/upstream} {duration}"
  errors
  hosts /etc/hosts {
    10.1.0.4 fv-az123-456
    fallthrough
  }
  cache 3600 {
    serve_stale 1h
  }
  forward . 9.9.9.9 149.112.112.112 {
    policy sequential
  }
}
.:53 {
  bind 127.0.0.1
  log . "{remote} BLOCK {type} {name} {rcode}"
  errors
  template ANY ANY {
    rcode NXDOMAIN
  }
}
",
