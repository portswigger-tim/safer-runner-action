runner ALL=(ALL) NOPASSWD: SAFER_RUNNER_VALIDATION

# The job's own command lines (sudo-config), as root only
Cmnd_Alias SAFER_RUNNER_JOB = /usr/bin/apt-get update, \\
    /usr/bin/apt-get install *, \\
    /usr/bin/nproc ""

runner ALL=(root) NOPASSWD: SAFER_RUNNER_JOB

