exports[`setup transcript (runSetup on a recording fake runner) analyze, docker: stop with running service containers: files 1`] = `
{
  "/etc/docker/daemon.json": "{
  "live-restore": true
}
",
  "/etc/resolv.conf": "nameserver 127.0.0.1
",
  "/etc/rsyslog.d/10-iptables-safer-runner-v2.conf": "if $programname == 'kernel' and $msg contains ['SaferRunner-Drop:', 'SaferRunner-Egress:', 'SaferRunner-CDrop:', 'SaferRunner-CEgress:'] then /var/log/safer-runner/firewall.log
",
  "/etc/safer-runner/Corefile": "# safer-runner CoreDNS resolver (analyze). Generated - do not edit.
# Blocks are tried in order: the first whose view matches answers the query.
.:53 {
  bind 127.0.0.1
  view allow {
    expr ((name() in ['github.com.', 'objects.githubusercontent.com.', 'productionresultssa1.blob.core.windows.net.', 'fulcio.githubapp.com.', 'pkg-containers.githubusercontent.com.'] || name() endsWith '.github.com.' || name() endsWith '.actions.githubusercontent.com.' || name() matches '^hosted-compute-[a-z0-9_-]*[.]githubapp[.]com[.]$') && !(name() in ['gist.github.com.', 'gist.githubusercontent.com.', 'raw.githubusercontent.com.'])) || name() in ['localhost.', 'ip6-localhost.', 'ip6-loopback.', 'fv-az123-456.']
  }
  metadata
  log . "{remote} ALLOW {type} {name} {rcode} upstream={/forward/upstream} {duration}"
  errors
  hosts /etc/hosts {
    10.1.0.4 fv-az123-456
    fallthrough
  }
  cache 3600 {
    serve_stale 1h
  }
  forward . 9.9.9.9 149.112.112.112 {
    policy sequential
  }
}
.:53 {
  bind 127.0.0.1
  metadata
  log . "{remote} WOULD_BLOCK {type} {name} {rcode} upstream={/forward/upstream} {duration}"
  errors
  cache 3600 {
    serve_stale 1h
  }
  forward . 9.9.9.9 149.112.112.112 {
    policy sequential
  }
}
