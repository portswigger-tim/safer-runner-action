exports[`setup transcript (runSetup on a recording fake runner) enforce, docker: keep with running service containers: warnings 1`] = `
[
  "warning: enforce is ADVISORY in this job: docker is retained (docker: keep), and docker access is root-equivalent, so any step can use it to remove the egress controls. Use docker: remove-group (the enforce default) or docker: stop unless the job needs docker.",
]
`;

