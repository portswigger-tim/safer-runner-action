// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`post step transcript enforce: integrity, report: transcript 1`] = `
"$ sudo -n cat /etc/safer-runner/validation-state.json [ignore-rc] [silent]
$ sudo cat /etc/safer-runner/Corefile [ignore-rc] [silent]
$ sudo cat /etc/resolv.conf [ignore-rc] [silent]
$ sudo cat /etc/systemd/resolved.conf.d/no-stub.conf [ignore-rc] [silent]
$ sudo cat /etc/safer-runner/policy.json [ignore-rc] [silent]
$ sudo cat /opt/safer-runner/proxy/policy.py [ignore-rc] [silent]
$ sudo cat /opt/safer-runner/proxy/policy_core.py [ignore-rc] [silent]
$ sudo cat /etc/sudoers.d/00-sudo-logging [ignore-rc] [silent]
$ sudo iptables -L INPUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L OUTPUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L FORWARD -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L SAFER_RUNNER_OUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L OUTPUT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L SAFER_RUNNER_NAT -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L DOCKER-USER -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -L SAFER_RUNNER_CFWD -n --line-numbers [ignore-rc] [silent]
$ sudo iptables -t nat -L SAFER_RUNNER_CNAT -n --line-numbers [ignore-rc] [silent]
$ docker ps -aq [ignore-rc] [silent]
$ <summary.write>"
`;

