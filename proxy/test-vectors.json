{
  "comment": "Shared hostname-matching vectors. Checked by proxy/policy_core_test.py AND src/policy.test.ts so the TypeScript and Python matchers can never disagree.",
  "match": [
    { "pattern": "example.com", "host": "example.com", "expect": true },
    { "pattern": "example.com", "host": "api.example.com", "expect": true },
    { "pattern": "example.com", "host": "a.b.example.com", "expect": true },
    { "pattern": "example.com", "host": "EXAMPLE.COM.", "expect": true },
    { "pattern": "example.com", "host": "example.com:443", "expect": true },
    { "pattern": "example.com", "host": "badexample.com", "expect": false },
    { "pattern": "example.com", "host": "example.com.evil.net", "expect": false },
    { "pattern": "example.com", "host": "", "expect": false },
    { "pattern": "*.example.com", "host": "example.com", "expect": false },
    { "pattern": "*.example.com", "host": "a.example.com", "expect": true },
    { "pattern": "*.example.com", "host": "a.b.example.com", "expect": true },
    { "pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-westus2.githubapp.com", "expect": true },
    { "pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-.githubapp.com", "expect": true },
    { "pattern": "hosted-compute-*.githubapp.com", "host": "x.hosted-compute-a.githubapp.com", "expect": false },
    { "pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-a.b.githubapp.com", "expect": false },
    { "pattern": "hosted-compute-*.githubapp.com", "host": "githubapp.com", "expect": false },
    { "pattern": "productionresultssa1.blob.core.windows.net", "host": "productionresultssa1.blob.core.windows.net", "expect": true },
    { "pattern": "productionresultssa1.blob.core.windows.net", "host": "productionresultssa10.blob.core.windows.net", "expect": false },
    { "pattern": "productionresultssa1.blob.core.windows.net", "host": "evil.blob.core.windows.net", "expect": false }
  ],
  "invalid_patterns": ["", "com", "*", "*.com", "example.*", "1.2.3.4", "exa mple.com", "*.foo-*.example.com", "-bad.example.com"]
}
