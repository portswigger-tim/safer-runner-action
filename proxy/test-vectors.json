{
  "comment": "Shared hostname-matching vectors. Checked by proxy/policy_core_test.py, src/policy.test.ts AND the Corefile expression builder (src/config/corefile-builder.test.ts) so the TypeScript, Python and DNS matchers can never disagree. A bare name is EXACT; *.name is subdomains only.",
  "match": [
    {"pattern": "example.com", "host": "example.com", "expect": true},
    {"pattern": "example.com", "host": "api.example.com", "expect": false},
    {"pattern": "example.com", "host": "a.b.example.com", "expect": false},
    {"pattern": "example.com", "host": "EXAMPLE.COM.", "expect": true},
