    {"pattern": "example.com", "host": "badexample.com", "expect": false},
    {"pattern": "example.com", "host": "example.com.evil.net", "expect": false},
    {"pattern": "example.com", "host": "", "expect": false},
    {"pattern": "*.example.com", "host": "example.com", "expect": false},
    {"pattern": "*.example.com", "host": "a.example.com", "expect": true},
    {"pattern": "*.example.com", "host": "a.b.example.com", "expect": true},
    {"pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-westus2.githubapp.com", "expect": true},
    {"pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-.githubapp.com", "expect": true},
    {"pattern": "hosted-compute-*.githubapp.com", "host": "x.hosted-compute-a.githubapp.com", "expect": false},
    {"pattern": "hosted-compute-*.githubapp.com", "host": "hosted-compute-a.b.githubapp.com", "expect": false},
    {"pattern": "hosted-compute-*.githubapp.com", "host": "githubapp.com", "expect": false},
    {"pattern": "productionresultssa1.blob.core.windows.net", "host": "productionresultssa1.blob.core.windows.net", "expect": true},
    {"pattern": "productionresultssa1.blob.core.windows.net", "host": "productionresultssa10.blob.core.windows.net", "expect": false},
    {"pattern": "productionresultssa1.blob.core.windows.net", "host": "evil.blob.core.windows.net", "expect": false},
    {"pattern": "*.example.com", "host": "EXAMPLE.com", "expect": false},
    {"pattern": "*.example.com", "host": "x.badexample.com", "expect": false},
    {"pattern": "*.example.com", "host": "example.com.evil.net", "expect": false},
    {"pattern": "github.com", "host": "s3cr3t.github.com", "expect": false},
    {"pattern": "objects.githubusercontent.com", "host": "x.objects.githubusercontent.com", "expect": false},
    {"pattern": "*.actions.githubusercontent.com", "host": "pipelines.actions.githubusercontent.com", "expect": true},
    {"pattern": "*.actions.githubusercontent.com", "host": "actions.githubusercontent.com", "expect": false},
    {"pattern": "productionresultssa*.blob.core.windows.net", "host": "productionresultssa7.blob.core.windows.net", "expect": true},
    {"pattern": "productionresultssa*.blob.core.windows.net", "host": "x.productionresultssa7.blob.core.windows.net", "expect": false},
    {"pattern": "productionresultssa*.blob.core.windows.net", "host": "attacker.blob.core.windows.net", "expect": false}
  ],
  "path_comment": "http-filter path glob: the same * as host names, with / in the role of . (a lone * segment spans any depth; * inside a segment stays within it). Request paths are matched without the query string, percent-decoded once. Checked by proxy/policy_core_test.py; src/inputs.test.ts checks the pattern validation.",
  "path_match": [
    {"pattern": "*", "path": "/", "expect": true},
    {"pattern": "*", "path": "/anything/at/all?x=1", "expect": true},
    {"pattern": "/", "path": "/", "expect": true},
    {"pattern": "/", "path": "/a", "expect": false},
    {"pattern": "*/git-receive-pack", "path": "/owner/repo.git/git-receive-pack", "expect": true},
    {"pattern": "*/git-receive-pack", "path": "/owner/repo/git-receive-pack", "expect": true},
    {"pattern": "*/git-receive-pack", "path": "/owner/repo.git/git-upload-pack", "expect": false},
    {"pattern": "*/git-receive-pack", "path": "/git-receive-pack", "expect": false},
    {"pattern": "*/git-receive-pack", "path": "/owner/repo.git/git-receive-pack-x", "expect": false},
    {"pattern": "*/git-receive-pack", "path": "/owner/repo.git/git-receive-pac%6b", "expect": true},
    {"pattern": "portswigger-tim/*/git-receive-pack", "path": "/portswigger-tim/app.git/git-receive-pack", "expect": true},
    {"pattern": "portswigger-tim/*/git-receive-pack", "path": "/attacker/app.git/git-receive-pack", "expect": false},
    {"pattern": "portswigger-tim/*/git-receive-pack", "path": "/portswigger-timx/app.git/git-receive-pack", "expect": false},
    {"pattern": "portswigger-tim/*/git-receive-pack", "path": "/PortSwigger-Tim/app.git/git-receive-pack", "expect": false},
    {"pattern": "/twirp/*", "path": "/twirp/results.services.receiver.Receiver/CreateArtifact", "expect": true},
    {"pattern": "/twirp/*", "path": "/twirpx/a", "expect": false},
    {"pattern": "/twirp/*", "path": "/twirp", "expect": false},
    {"pattern": "*/idtoken/*", "path": "/40//idtoken/abc/def?api-version=2.0", "expect": true},
    {"pattern": "*/idtoken/*", "path": "/40/idtokens/abc", "expect": false},
    {"pattern": "pre*", "path": "/prefix", "expect": true},
    {"pattern": "pre*", "path": "/pre", "expect": true},
    {"pattern": "pre*", "path": "/prefix/more", "expect": false},
    {"pattern": "a/*.tgz", "path": "/a/pkg-1.0.0.tgz", "expect": true},
    {"pattern": "a/*.tgz", "path": "/a/b/pkg-1.0.0.tgz", "expect": false},
    {"pattern": "@scope/*", "path": "/@scope%2fpkg", "expect": true},
    {"pattern": "v2/*/blobs/*", "path": "/v2/org/img/blobs/sha256:abc", "expect": true}
  ],
  "git_comment": "Paths on a git host (GIT_HOSTS: github.com): case-insensitive, and one .git suffix is dropped from every segment of both the path and the pattern, so every spelling of a repository gets the same verdict (and *.git is a one-segment *). git_pattern_keys: two patterns with the same key are duplicates on a git host.",
  "git_hosts": ["github.com"],
  "git_path_match": [
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo/git-receive-pack", "expect": true},
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo.git/git-receive-pack", "expect": true},
    {"pattern": "org/repo/git-receive-pack", "path": "/ORG/Repo.GIT/git-receive-pack", "expect": true},
    {"pattern": "org/repo.git/git-receive-pack", "path": "/org/repo/git-receive-pack", "expect": true},
    {"pattern": "Org/Repo/git-receive-pack", "path": "/org/repo.git/git-receive-pack", "expect": true},
    {"pattern": "org/secret/*", "path": "/org/secret.git/git-receive-pack", "expect": true},
    {"pattern": "org/secret/*", "path": "/Org/SECRET/info/refs?service=git-receive-pack", "expect": true},
    {"pattern": "org/*.git/info/refs", "path": "/org/repo/info/refs", "expect": true},
    {"pattern": "org/*.git/info/refs", "path": "/org/a/b/info/refs", "expect": false},
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo2/git-receive-pack", "expect": false},
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo.git2/git-receive-pack", "expect": false},
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo.gitx/git-receive-pack", "expect": false},
    {"pattern": "org/repo/git-receive-pack", "path": "/org/repo.git.git/git-receive-pack", "expect": false},
    {"pattern": "org/repo/git-receive-pack", "path": "/other/repo.git/git-receive-pack", "expect": false},
    {"pattern": "*/git-receive-pack", "path": "/a/b.git/GIT-RECEIVE-PACK", "expect": true},
    {"pattern": "org/*.git/info/refs", "path": "/org/repo.git/info/refs", "expect": true},
    {"pattern": "org/repo.g*/git-receive-pack", "path": "/org/repo.git/git-receive-pack", "expect": false},
    {"pattern": "org/repo/*", "path": "/org/repo.git/", "expect": true}
  ],
  "git_pattern_keys": [
    {"pattern": "org/repo/git-receive-pack", "key": "org/repo/git-receive-pack"},
    {"pattern": "/Org/Repo.git/git-receive-pack", "key": "org/repo/git-receive-pack"},
    {"pattern": "org/*.git/info/refs", "key": "org/*.git/info/refs"},
    {"pattern": "org/*/info/refs", "key": "org/*/info/refs"},
    {"pattern": "*", "key": "*"},
    {"pattern": "/", "key": ""},
    {"pattern": "org/.git/x", "key": "org/.git/x"}
  ],
  "invalid_path_patterns": ["a//b", "a/", "a/../b", "./a", "a/./b", "**", "a/**/b", "a?b", "a#b", "a%2fb", "a\\b", "a b", "caf\u00e9"],
  "valid_path_patterns": ["*", "/", "", "/twirp/*", "*/git-receive-pack", "portswigger-tim/*/git-receive-pack", "pre*", "v2/*/blobs/*", "a:b", "@scope/*"],
  "selftest_comment": "The action's own setup probe (src/selftest.ts repointSelfTest; proxy/policy_core.py is_selftest_probe), exempt from http-filter.",
  "selftest_probe": {"host": "github.com", "method": "GET", "path": "/robots.txt", "dst_ip": "192.0.2.1"},
  "invalid_patterns": ["", "com", "*", "*.com", "example.*", "1.2.3.4", "exa mple.com", "*.foo-*.example.com", "-bad.example.com"],
  "front_doors": ["*.blob.core.windows.net", "*.dfs.core.windows.net", "*.file.core.windows.net", "*.queue.core.windows.net", "*.table.core.windows.net", "*.web.core.windows.net"],
  "front_door_hosts": [
