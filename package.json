{
  "name": "safer-runner",
  "version": "2.5.2",
  "description": "L7 egress control for GitHub Actions runners: hostname allowlisting through a TLS-terminating proxy",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && ncc build lib/main.js -o dist/main --license licenses.txt",
    "build:pre": "ncc build lib/pre.js -o dist/pre --license licenses.txt",
    "build:post": "ncc build lib/post.js -o dist/post --license licenses.txt",
    "clean": "rm -rf dist lib",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "npm run clean && npm run format && npm test && npm run build && npm run build:pre && npm run build:post",
    "test": "jest && npm run test:py",
    "all": "npm run package",
    "gen:domains": "tsc && node lib/scripts/gen-github-domains.js && prettier --write src/config/github-domains.generated.ts",
    "test:py": "python3 -m unittest discover -s proxy -p '*_test.py'"
  },
  "keywords": [
    "security",
    "github-actions",
    "egress",
    "proxy",
    "mitmproxy"
  ],
  "author": "PortSwigger",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.2"
  }
}
